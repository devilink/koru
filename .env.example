# Environment variables for companion-bot
# NEVER COMMIT THE ACTUAL .env FILE!

# Server config
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/companion.sqlite3

# Qdrant (Local)
QDRANT_URL=http://localhost:6333

# Ollama (Local)
OLLAMA_URL=http://localhost:11434

# MQTT (Mosquitto)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# Face Embeddings Encryption Key
# Generate a new Fernet key for production:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY

# Security Policy
SAFETY_MODE_ENABLED=true
COOLDOWN_PERIOD_SECONDS=300
TRACKING_DURATION_SECONDS=10
